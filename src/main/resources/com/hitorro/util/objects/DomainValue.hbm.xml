<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="com.hitorro.util.objects">

    <class name="com.hitorro.util.objects.DomainValue" table="DomainValue">
        <id name="id" type="long" column="domainvalue_id">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <property name="domain" type="string" not-null="true"/>
        <property name="value" type="string" not-null="true"/>

    </class>
</hibernate-mapping>