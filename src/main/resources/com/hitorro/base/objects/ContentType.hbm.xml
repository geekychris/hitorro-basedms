<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="ht.base.objects">

    <class name="com.hitorro.base.objects.ContentType" table="ContentType">
        <meta attribute="class-description">
            ContentType
        </meta>
        <id name="id" type="long" column="contenttype_id">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <property name="mimeType" type="string" not-null="true"/>
        <property name="guid" type="string" not-null="true"/>
        <set name="extensions" table="contenttype_extensions" inverse="true" cascade="all" lazy="false">
            <key column="contenttype_id"/>
            <one-to-many class="com.hitorro.base.objects.Extension"/>
        </set>
    </class>
</hibernate-mapping>