<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping package="ht.base.objects">
    <joined-subclass name="com.hitorro.base.objects.SubjectArea" table="SubjectArea" extends="com.hitorro.base.objects.VersionableObject">
        <key column="system_id"/>
        <property name="name" type="string" length="20" not-null="true" index="name_idx"/>
        <property name="displayName" type="string" length="100" not-null="true"/>
        <set name="personalities" table="subjectarea_user" lazy="true">
            <key column="subjectarea_id"/>
            <many-to-many column="user_id" class="com.hitorro.base.objects.User"/>
        </set>
        <!--
        <set name="forums" table="subjectarea_forum" lazy="true">
            <key column="subjectarea_id"/>
            <one-to-many class="ht.base.objects.Forum"/>
        </set>
        -->
    </joined-subclass>
</hibernate-mapping>
