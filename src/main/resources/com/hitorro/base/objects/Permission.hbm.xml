<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="com.hitorro.base.objects">

    <joined-subclass name="com.hitorro.base.objects.Permission" table="Permission" extends="com.hitorro.base.objects.VersionableObject">
        <meta attribute="class-description">
            Permission object
        </meta>
        <key column="system_id"/>
        <property name="name" type="string" length="20" not-null="true" index="name_idx"/>
        <property name="description" type="string" length="255"/>

    </joined-subclass>
</hibernate-mapping>