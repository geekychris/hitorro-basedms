<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="com.hitorro.base.objects">
    <joined-subclass name="com.hitorro.base.objects.Document" table="document" extends="com.hitorro.base.objects.VersionableObject">
        <meta attribute="class-description">
            Document Object
        </meta>
        <key column="system_id"/>
        <property name="title" type="string" not-null="true"/>
        <property name="content" type="string" not-null="false"/>
        <property name="titleHash" type="long"/>
        <many-to-one name="author" class="com.hitorro.base.objects.User" column="author_id" fetch="select"/>
    </joined-subclass>
</hibernate-mapping>