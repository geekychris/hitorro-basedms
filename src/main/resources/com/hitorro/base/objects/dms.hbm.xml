<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping
        PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <!-- chris's photo example
    <class name="ksw.jsp.photoalbum.PDirectory_h" table="PDIRECTORY">
        <meta attribute="class-description">
            A directory, containing a set of photographs
        </meta>

        <id name="id" type="int" column="PDIRECTORY_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>

        <property name="path" type="string" not-null="true"/>
        <property name="name" type="string" not-null="true"/>
        <property name="lastdate" type="date" not-null="true"/>
    </class>

    <class name="ksw.jsp.photoalbum.Photo_h" table="PHOTO">
        <meta attribute="class-description">
            A single photo in the collection
        </meta>

        <id name="id" type="int" column="PHOTO_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>

        <property name="name" type="string">
            <column name="NAME" not-null="true" index="PHOTO_NAME_IDX"/>
        </property>

        <many-to-one name="pdirectory" class="ksw.jsp.photoalbum.PDirectory_h" not-null="true"/>

        <set name="keywords" table="PHOTO_KEYWORDS" lazy="true">
            <key column="PHOTO_ID"/>
            <many-to-many class="ksw.jsp.photoalbum.Keyword_h" column="KEYWORD_ID"/>
        </set>

        <many-to-one name="comment" class="ksw.jsp.photoalbum.Comment_h"/>
    </class>

    <class name="ksw.jsp.photoalbum.CommentElement_h" table="COMMENTELEMENT">
        <meta attribute="class-description">
            A piece of a comment, allowing long pieces of text
        </meta>
        <id name="id" type="int" column="COMMENTELEMENT_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <many-to-one name="parent" column="COMMENT_ID" class="ksw.jsp.photoalbum.Comment_h"/>
        <property name="theOrder" column="THEORDER" type="int"/>
        <property name="s0" type="string"/>
        <property name="s1" type="string"/>
        <property name="s2" type="string"/>
        <property name="s3" type="string"/>
    </class>

    <class name="ksw.jsp.photoalbum.Comment_h" table="COMMENT">
        <meta attribute="class-description">
            A comment for a single photograph, album or break
        </meta>

        <id name="id" type="int" column="COMMENT_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>

        <lists name="elements" table="COMMENT_COMMENTELEMENTS" inverse="true" cascade="all">
            <key column="COMMENT_ID"/>
            <index column="THEORDER"/>
            <one-to-many class="ksw.jsp.photoalbum.CommentElement_h"/>
        </lists>
    </class>

    <class name="ksw.jsp.photoalbum.Keyword_h" table="KEYWORD">
        <meta attribute="class-description">
            A keyword, used to describe an attribute of a photo
        </meta>

        <id name="id" type="int" column="KEYWORD_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>

        <property name="word" type="string" not-null="true"/>

        <set name="photos" table="PHOTO_KEYWORDS" inverse="true" lazy="true">
            <key column="KEYWORD_ID"/>
            <many-to-many class="ksw.jsp.photoalbum.Photo_h" column="PHOTO_ID"/>
        </set>
    </class>

    <class name="ksw.jsp.photoalbum.Album_h" table="ALBUM">
        <meta attribute="class-description">
            A constructed album, containing other albums and photos
        </meta>

        <id name="id" type="int" column="ALBUM_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>

        <property name="name" type="string" not-null="true"/>
        <property name="subtitle" type="string"/>

        <lists name="items" table="ALBUM_ALBUMITEMS" lazy="true" cascade="all">
            <key column="ALBUM_ID"/>
            <index column="THEORDER"/>
            <one-to-many class="ksw.jsp.photoalbum.AlbumItem_h"/>
        </lists>

        <many-to-one name="comment" class="ksw.jsp.photoalbum.Comment_h"/>
    </class>

    <class name="ksw.jsp.photoalbum.AlbumItem_h" table="ALBUMITEM">
        <meta attribute="class-description">
            A single item in an album
        </meta>

        <id name="id" type="int" column="ALBUMITEM_ID">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <many-to-one name="album" column="ALBUM_ID" class="ksw.jsp.photoalbum.Album_h"/>

        <property name="type" type="int" not-null="true"/>
        <property name="theOrder" column="THEORDER" type="int"/>
        <many-to-one name="photo" column="PHOTO_ID" class="ksw.jsp.photoalbum.Photo_h" cascade="none"/>
        <many-to-one name="subAlbum" column="SUBALBUM_ID" class="ksw.jsp.photoalbum.Album_h" cascade="none"/>
        <property name="comment" type="string"/>
    </class>
    -->

</hibernate-mapping>

