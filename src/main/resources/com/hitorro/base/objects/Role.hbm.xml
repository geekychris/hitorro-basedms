<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="ht.base.objects">

    <joined-subclass name="com.hitorro.base.objects.Role" table="Role" extends="com.hitorro.base.objects.VersionableObject">
        <meta attribute="class-description">
            Role object
        </meta>
        <key column="system_id"/>
        <property name="name" type="string" length="20" not-null="true" index="name_idx"/>
        <property name="description" type="string" length="255"/>

        <set name="permissions" table="role_permission" lazy="true">
            <key column="role_id"/>
            <many-to-many column="permission_id" class="com.hitorro.base.objects.Permission"/>
        </set>

    </joined-subclass>
</hibernate-mapping>