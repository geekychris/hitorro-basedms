<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="com.hitorro.base.objects">

    <class name="com.hitorro.base.objects.DomainInfo" table="DomainInfo">
        <id name="id" type="long" column="domaininfo_id">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <property name="domain" type="string" not-null="true"/>
        <property name="displayName" type="string" not-null="true"/>
        <property name="description" type="string" not-null="true"/>
        <property name="valueMapImpl" type="string" not-null="true"/>

    </class>
</hibernate-mapping>