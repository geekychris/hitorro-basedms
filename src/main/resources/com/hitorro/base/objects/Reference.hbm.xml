<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="com.hitorro.base.objects">

    <class name="com.hitorro.base.objects.Reference" table="Reference">
        <meta attribute="class-description">
            Named Longs keep track of
        </meta>
        <id name="id" type="long" column="reference_id">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <version name="versionStamp" column="versionStamp" unsaved-value="null"/>
        <property name="fromGuid" type="string" not-null="true" index="fromguid_idx"/>
        <property name="toGuid" type="string" not-null="true" index="toguid_idx"/>
        <property name="refType" type="string" not-null="true" index="type_idx"/>
        <property name="auxData" type="string"/>

        <property name="fromHash" type="long" not-null="true" index="fromhash_idx"/>
        <property name="toHash" type="long" not-null="true" index="tohash_idx"/>
        <property name="date" type="timestamp" not-null="true"/>
    </class>
</hibernate-mapping>