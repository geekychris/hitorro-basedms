<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "htbin://data//dtds//hibernate-mapping-3.0.dtd">
<hibernate-mapping
        package="ht.basedms.workflow">

    <class name="com.hitorro.basedms.workflow.OutstandingWorkflowItem" table="OutstandingWorkflowItem">
        <id name="id" type="long" column="outstandingworkflow_id">
            <meta attribute="scope-set">protected</meta>
            <generator class="native"/>
        </id>
        <many-to-one name="WorkFlowItem" column="system_id" class="com.hitorro.basedms.workflow.WorkFlowItem"/>
        <property name="itemGuid" type="string" not-null="true"/>
        <property name="itemName" type="string" not-null="true"/>
        <property name="itemType" type="string" not-null="true"/>
    </class>

</hibernate-mapping>